# ========================================================
# PEHALWAN KARAHI & BAR B Q — ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# --------------------------------------------------------
# The public URL of your Express backend API.
# Note: Next.js embeds NEXT_PUBLIC_* variables at build time.
# Development: http://localhost:5050/api
# Production: https://api.yourdomain.com/api
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# --------------------------------------------------------
# BACKEND CONFIGURATION (Express.js)
# --------------------------------------------------------
# Server listening port.
# On Hostinger, PORT is usually injected automatically by Hostinger's Node.js reverse proxy.
# Local development default: 5050
PORT=5050

# Server host binding (0.0.0.0 binds to all network interfaces for container/reverse-proxy routing)
HOST=0.0.0.0

# Node environment (production | development)
NODE_ENV=production

# Frontend URL(s) allowed to access this API via CORS.
# Separate multiple URLs with commas if using apex and www domains.
# Local development default: http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# Optional Initial Superadmin Setup (used when store.json is first created)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=admin@yourdomain.com
