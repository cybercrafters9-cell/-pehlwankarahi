# ========================================================
# PEHLWAN KARAHI & BAR B Q — BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Port for Express server
PORT=5050

# Host binding (0.0.0.0 is required for production/container deployments)
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# Trust proxy configuration (behind Hostinger or reverse proxy, set TRUST_PROXY=1 so Express accurately logs and rate-limits client IPs)
TRUST_PROXY=1

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# JWT Secret Key for Admin Authentication (required, minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Database Configuration (MySQL / MariaDB on Hostinger)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_pkadmin
DB_PASSWORD=your_secure_mysql_password
DB_NAME=u123456789_pehalwankarahi

# Initial Superadmin Account Defaults (seeded automatically on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=admin@yourdomain.com
