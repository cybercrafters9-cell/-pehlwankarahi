# ========================================================
# PEHALWAN KARAHI & BAR B Q — BACKEND ENVIRONMENT VARIABLES
# ========================================================

# Port for Express server
PORT=5050

# Host binding (0.0.0.0 is required for production/container deployments)
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com

# Optional Initial Superadmin Account Defaults
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_EMAIL=admin@yourdomain.com
